    <select id="pageQuery" resultType="com.sky.entity.Employee">
        select * from employee
        <where>
            <if test="name != null and name != '' ">
                name like concat('%',#{name},'%')
            </if>
        </where>
    </select>
    <!-- 员工状态控制 -->
    <!-- 这个不能判断当前的status = '' 因为这个是Int类型的,不能这样比较   -->
    <update id="update">
        update employee
        <set>
            <if test="status != null">
                status = #{status},
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>
